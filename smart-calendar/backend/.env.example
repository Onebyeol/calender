# ============================================================
# 신박한 캘린더 - 환경변수 예시
# 이 파일을 .env로 복사해서 값을 채우세요.
#
#   cp .env.example .env
#
# .env는 .gitignore에 있어서 커밋되지 않습니다. 실제 키를 여기(.env.example)에
# 직접 적지 마세요 — 이 파일은 저장소에 그대로 올라갑니다.
# ============================================================


# ---------- 필수 1. MongoDB ----------
# 없으면 서버가 부팅 단계에서 종료됩니다(server.js에서 process.exit(1)).
#
# MongoDB Atlas에서 무료 클러스터를 만들고 "Connect → Drivers"의 연결 문자열을 붙여넣으세요.
# 주의: Atlas의 Network Access에 접속 IP를 등록해야 합니다.
#       배포 서버는 IP가 계속 바뀌므로 0.0.0.0/0 을 등록하는 게 편합니다.
# 주의: <password> 자리에 실제 비밀번호를 넣어야 하고, 특수문자는 URL 인코딩해야 합니다.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart-calendar?retryWrites=true&w=majority


# ---------- 필수 2. Gemini API ----------
# 없으면 서버는 뜨지만 공지 분석(텍스트/이미지)이 500 에러가 납니다.
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (선택) 사용할 모델. 콤마로 여러 개를 적으면 앞에서부터 시도하다가
# 실패하면 자동으로 다음 모델로 넘어갑니다(geminiService.js의 withModelFallback).
# 특정 모델이 그날 불안정하거나 막혀도 시연이 멈추지 않게 하는 안전장치라,
# 발표 전에는 2~3개를 등록해두는 걸 권합니다.
# 비워두면 기본값 gemini-3.1-flash-lite 하나만 씁니다.
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.1-flash,gemini-2.5-flash


# ---------- 선택 3. 웹 푸시(VAPID) ----------
# 없어도 앱은 정상 동작하고, 푸시 발송만 조용히 꺼집니다(pushService.js에서 경고 로그만 출력).
#
# 키 생성:
#   npx web-push generate-vapid-keys
#
# 출력된 Public Key / Private Key를 아래에 그대로 넣으세요.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스에 연락처로 전달되는 값. 팀 이메일로 바꿔두면 됩니다.
VAPID_SUBJECT=mailto:hanbyeol677@gmail.com


# ---------- 선택 4. 포트 ----------
# 비워두면 4000. Render/Railway 같은 배포 플랫폼은 PORT를 자동으로 주입하므로
# 배포 환경에서는 따로 설정하지 않아도 됩니다.
PORT=4000
